route(["/api/ai-bots/:botId/training"], "post", [requireUser, async (req, res, next) => {
  try {
    const bot = await requireAiBot(req, res);
    if (!bot) return;
    const trainingCategory = normalizeTrainingCategory(req.body.training_category);
    const title = cleanString(req.body.title);
    const contentText = cleanString(req.body.content_text);
    const exampleText = cleanString(req.body.example_text);
    const apiUsageWhen = cleanString(req.body.api_usage_when);
    const apiRequiredData = cleanString(req.body.api_required_data);
    const apiExample = cleanString(req.body.api_example);
    const apiRunTiming = req.body.api_run_timing === "after_payment" ? "after_payment" : "before_payment";
    const attachments = await normalizeTrainingAttachments(req.body.attachments, req.user);
    if (!title) return jsonError(res, 422, "Vui lòng nh?p tên n?i dung dào t?o.");
    if (!contentText && !attachments.length) return jsonError(res, 422, "Vui lòng nh?p n?i dung ho?c dính kèm file dào t?o.");

    await exec(
      "INSERT INTO ai_bot_training_items (user_id, bot_id, training_category, title, content_text, example_text, api_usage_when, api_required_data, api_example, api_run_timing, attachments_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
      [req.user.id, bot.id, trainingCategory, title, contentText, exampleText, apiUsageWhen, apiRequiredData, apiExample, apiRunTiming, safeJson(attachments)]
    );
    const rows = await query(
      `SELECT id, user_id, bot_id, training_category, title, content_text, example_text, api_usage_when, api_required_data, api_example, api_run_timing, attachments_json,
              DATE_FORMAT(created_at, '%Y-%m-%d %H:%i:%s') AS created_at,
              DATE_FORMAT(updated_at, '%Y-%m-%d %H:%i:%s') AS updated_at
       FROM ai_bot_training_items WHERE bot_id = ? AND user_id = ? ORDER BY id DESC`,
      [bot.id, req.user.id]
    );
    res.status(201).json({ success: true, message: "Ðã thêm n?i dung dào t?o.", training_items: rows.map(publicTrainingItem), bots: (await aiBotRows(req.user.id)).map(publicAiBot) });
  } catch (error) {
    next(error);
  }
}]);

route(["/api/ai-bots/:botId/training/:itemId"], "put", [requireUser, async (req, res, next) => {
  try {
    const bot = await requireAiBot(req, res);
    if (!bot) return;
    const itemId = Number(req.params.itemId || 0);
    const existing = (await query("SELECT id, attachments_json FROM ai_bot_training_items WHERE id = ? AND bot_id = ? AND user_id = ? LIMIT 1", [itemId, bot.id, req.user.id]))[0];
    if (!existing) return jsonError(res, 404, "Không tìm th?y n?i dung dào t?o.");

    const trainingCategory = normalizeTrainingCategory(req.body.training_category);
    const title = cleanString(req.body.title);
    const contentText = cleanString(req.body.content_text);
    const exampleText = cleanString(req.body.example_text);
    const apiUsageWhen = cleanString(req.body.api_usage_when);
    const apiRequiredData = cleanString(req.body.api_required_data);
    const apiExample = cleanString(req.body.api_example);
    const apiRunTiming = req.body.api_run_timing === "after_payment" ? "after_payment" : "before_payment";
    const attachments = await normalizeTrainingAttachments(req.body.attachments, req.user);
    if (!title) return jsonError(res, 422, "Vui lòng nh?p tên n?i dung dào t?o.");
    if (!contentText && !attachments.length) return jsonError(res, 422, "Vui lòng nh?p n?i dung ho?c dính kèm file dào t?o.");

    await exec(
      "UPDATE ai_bot_training_items SET training_category = ?, title = ?, content_text = ?, example_text = ?, api_usage_when = ?, api_required_data = ?, api_example = ?, api_run_timing = ?, attachments_json = ? WHERE id = ? AND bot_id = ? AND user_id = ?",
      [trainingCategory, title, contentText, exampleText, apiUsageWhen, apiRequiredData, apiExample, apiRunTiming, safeJson(attachments), itemId, bot.id, req.user.id]
    );
    const nextPaths = new Set(attachments.map((attachment) => attachment.path).filter(Boolean));
    const oldAttachments = parseJsonArray(existing.attachments_json).filter((attachment) => attachment.path && !nextPaths.has(attachment.path));
    await deleteTrainingAttachments(oldAttachments);
    const rows = await query(
      `SELECT id, user_id, bot_id, training_category, title, content_text, example_text, api_usage_when, api_required_data, api_example, api_run_timing, attachments_json,
              DATE_FORMAT(created_at, '%Y-%m-%d %H:%i:%s') AS created_at,
              DATE_FORMAT(updated_at, '%Y-%m-%d %H:%i:%s') AS updated_at
       FROM ai_bot_training_items WHERE bot_id = ? AND user_id = ? ORDER BY id DESC`,
      [bot.id, req.user.id]
    );
    res.json({ success: true, message: "Ðã c?p nh?t n?i dung dào t?o.", training_items: rows.map(publicTrainingItem) });
  } catch (error) {
    next(error);
  }
}]);

route(["/api/ai-bots/:botId/training/:itemId"], "delete", [requireUser, async (req, res, next) => {
  try {
    const bot = await requireAiBot(req, res);

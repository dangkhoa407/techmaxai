  await addColumnIfMissing("ai_api_keys", "label", "label VARCHAR(160) DEFAULT NULL AFTER api_key");
  await addColumnIfMissing("ai_api_keys", "status", "status ENUM('active', 'inactive') NOT NULL DEFAULT 'active' AFTER label");

async function updateProfile(req, res, next) {
  try {
    const fullname = cleanString(req.body.fullname ?? req.user.fullname);
    if (!fullname) return jsonError(res, 422, "H? tên không du?c d? tr?ng.");
    const values = [
      fullname,
      cleanString(req.body.phone),
      cleanString(req.body.address),
      cleanString(req.body.region),
      cleanString(req.body.tax_code),
      cleanString(req.body.province_city),
      cleanString(req.body.company),
      cleanString(req.body.citizen_id),
      req.user.id,
    ];
    await exec("UPDATE users SET fullname=?, phone=?, address=?, region=?, tax_code=?, province_city=?, company=?, citizen_id=? WHERE id=?", values);
    await logActivity(req.user.id, req, {
      subject: "H? so",
      action: "C?p nh?t h? so",
      target: "Thông tin cá nhân",
      detail: "Ðã c?p nh?t thông tin h? so tài kho?n.",
      tone: "orange",
    });
    const rows = await query("SELECT * FROM users WHERE id = ? LIMIT 1", [req.user.id]);
    res.json({ success: true, message: "C?p nh?t h? so thành công.", user: publicUser(rows[0]) });
  } catch (error) {
    next(error);
  }
}


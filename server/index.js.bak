}]);

route(["/api/admin/service-plans"], "post", [requireAdmin, async (req, res, next) => {
  try {
    const plan = normalizePlanPayload(req.body);
    if (!plan.code || !plan.name) return jsonError(res, 422, "Vui lòng nh?p mã gói và tên gói.");
    const result = await exec(
      `INSERT INTO service_plans
        (code, name, price, days, cycle, description, bots, channels, messages, support, features, is_popular, is_active, sort_order)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        plan.code,
        plan.name,
        plan.price,
        plan.days,
        plan.cycle,
        plan.description,
        plan.bots,
        plan.channels,
        plan.messages,
        plan.support,
        JSON.stringify(plan.features),
        plan.is_popular ? 1 : 0,
        plan.is_active ? 1 : 0,
        plan.sort_order,
      ]
    );
    const rows = await query("SELECT * FROM service_plans WHERE id = ? LIMIT 1", [result.insertId]);
    res.status(201).json({ success: true, message: "Ðã t?o gói d?ch v?.", plan: publicServicePlan(rows[0]) });
  } catch (error) {
    if (String(error.message || "").includes("Duplicate")) return jsonError(res, 409, "Mã gói dã t?n t?i.");
    next(error);
  }
}]);

route(["/api/admin/service-plans/:id"], "put", [requireAdmin, async (req, res, next) => {
  try {
    const id = Number(req.params.id || 0);
    const rows = await query("SELECT * FROM service_plans WHERE id = ? LIMIT 1", [id]);
    if (!rows[0]) return jsonError(res, 404, "Không tìm th?y gói d?ch v?.");
    const plan = normalizePlanPayload(req.body, rows[0]);
    if (!plan.code || !plan.name) return jsonError(res, 422, "Vui lòng nh?p mã gói và tên gói.");
    await exec(
      `UPDATE service_plans
       SET code=?, name=?, price=?, days=?, cycle=?, description=?, bots=?, channels=?, messages=?, support=?,
           features=?, is_popular=?, is_active=?, sort_order=?
       WHERE id=?`,
      [
        plan.code,
        plan.name,
        plan.price,
        plan.days,
        plan.cycle,
        plan.description,
        plan.bots,
        plan.channels,
        plan.messages,
        plan.support,
        JSON.stringify(plan.features),
        plan.is_popular ? 1 : 0,
        plan.is_active ? 1 : 0,
        plan.sort_order,
        id,
      ]
    );
    const updated = await query("SELECT * FROM service_plans WHERE id = ? LIMIT 1", [id]);
    res.json({ success: true, message: "Ðã c?p nh?t gói d?ch v?.", plan: publicServicePlan(updated[0]) });
  } catch (error) {
    if (String(error.message || "").includes("Duplicate")) return jsonError(res, 409, "Mã gói dã t?n t?i.");
    next(error);
  }
}]);

route(["/api/admin/service-plans/:id"], "delete", [requireAdmin, async (req, res, next) => {

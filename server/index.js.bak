}]);

route(["/api/login", "/api/login.php"], "post", [async (req, res, next) => {
  try {
    const email = String(cleanString(req.body.email) || "").toLowerCase();
    const password = String(req.body.password || "");
    const rows = await query("SELECT * FROM users WHERE email = ? LIMIT 1", [email]);
    const user = rows[0];
    if (!user || !(await comparePassword(password, user.password))) return jsonError(res, 401, "Email ho?c m?t kh?u không dúng.");
    if (!Number(user.email_verified)) return jsonError(res, 403, "Vui lòng xác th?c email tru?c khi dang nh?p.", { requires_verification: true, email: user.email });
    if (user.status !== "active") return jsonError(res, 403, "Tài kho?n dang b? khóa.");
    if (user.two_factor_enabled && user.two_factor_secret) {
      if (!req.body.two_factor_code) return jsonError(res, 428, "Vui lòng nh?p mã xác th?c 2 l?p.", { two_factor_required: true });
      if (!verifyTotp(user.two_factor_secret, req.body.two_factor_code)) return jsonError(res, 401, "Mã xác th?c 2 l?p không dúng ho?c dã h?t h?n.", { two_factor_required: true });
    }
    const token = await createSession(user.id, req);
    const fresh = (await query("SELECT * FROM users WHERE id = ? LIMIT 1", [user.id]))[0];
    await logActivity(user.id, req, {
      subject: "B?o m?t",
      action: "Ðang nh?p tài kho?n",
      actor: user.fullname,
      target: "Phiên dang nh?p",
      detail: `Ðang nh?p thành công t? ${parseDevice(req.headers["user-agent"]).device_name}.`,
      tone: "green",
    });
    res.json({ success: true, message: "Ðang nh?p thành công.", token, user: publicUser(fresh) });
  } catch (error) {
    next(error);
  }
}]);


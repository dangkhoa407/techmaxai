    const existing = (await query("SELECT attachments_json FROM ai_bot_training_items WHERE id = ? AND bot_id = ? AND user_id = ? LIMIT 1", [itemId, bot.id, req.user.id]))[0];
    if (existing) await deleteTrainingAttachments(parseJsonArray(existing.attachments_json));
    await exec("DELETE FROM ai_bot_training_items WHERE id = ? AND bot_id = ? AND user_id = ?", [itemId, bot.id, req.user.id]);

}]);

route(["/api/admin/dashboard"], "get", [requireAdmin, async (req, res, next) => {
  try {
    const [[{ total_users }]] = await pool.query("SELECT COUNT(*) AS total_users FROM users");
    const [[{ total_invoices }]] = await pool.query("SELECT COUNT(*) AS total_invoices FROM deposit_invoices");
    const [[{ total_tickets }]] = await pool.query("SELECT COUNT(*) AS total_tickets FROM tickets");
    const [[{ active_zalo }]] = await pool.query("SELECT COUNT(*) AS active_zalo FROM zalo_accounts WHERE status = 'active'");
    const [[{ total_money }]] = await pool.query("SELECT SUM(money) AS total_money FROM users");

    const recentUsers = await query("SELECT id, fullname, email, money, level, status, DATE_FORMAT(created_at, '%Y-%m-%d %H:%i:%s') AS created_at FROM users ORDER BY id DESC LIMIT 5");
    const recentTickets = await query(`
      SELECT t.id, t.subject, t.priority, t.status, u.fullname AS user_name, DATE_FORMAT(t.created_at, '%Y-%m-%d %H:%i:%s') AS created_at
      FROM tickets t
      LEFT JOIN users u ON t.user_id = u.id
      ORDER BY t.id DESC LIMIT 5
    `);
    const recentLogs = await query(`
      SELECT l.id, l.subject, l.action, l.detail, l.tone, u.fullname AS user_name, DATE_FORMAT(l.created_at, '%Y-%m-%d %H:%i:%s') AS created_at
      FROM activity_logs l
      LEFT JOIN users u ON l.user_id = u.id
      ORDER BY l.id DESC LIMIT 10
    `);

    res.json({
      success: true,
      stats: {
        total_users: Number(total_users || 0),
        total_invoices: Number(total_invoices || 0),
        total_tickets: Number(total_tickets || 0),
        active_zalo: Number(active_zalo || 0),
        total_money: Number(total_money || 0),
      },
      recent_users: recentUsers.map(u => ({ ...u, money: Number(u.money) })),
      recent_tickets: recentTickets,
      recent_logs: recentLogs,
    });
  } catch (error) {
    next(error);
  }
}]);


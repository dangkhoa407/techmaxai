route(["/api/admin/users/:id/money"], "put", [requireAdmin, async (req, res, next) => {
  try {
    const userId = Number(req.params.id || 0);
    const amount = Number(req.body.amount || 0);
    const type = req.body.type; // 'add' or 'subtract'
    const reason = cleanString(req.body.reason) || "Ði?u ch?nh s? du Admin";

    if (amount <= 0) return jsonError(res, 422, "S? ti?n di?u ch?nh ph?i l?n hon 0.");
    if (!["add", "subtract"].includes(type)) return jsonError(res, 422, "Lo?i di?u ch?nh không h?p l?.");

    const users = await query("SELECT id, money, fullname FROM users WHERE id = ? LIMIT 1", [userId]);
    const user = users[0];
    if (!user) return jsonError(res, 404, "Không tìm th?y ngu?i dùng.");

    const currentMoney = Number(user.money);
    let newMoney = currentMoney;
    if (type === "add") {
      newMoney += amount;
    } else {
      if (currentMoney < amount) return jsonError(res, 422, "S? du tài kho?n không d? d? tr?.");
      newMoney -= amount;
    }

    await exec("UPDATE users SET money = ? WHERE id = ?", [newMoney, userId]);

    await logActivity(userId, req, {
      subject: "Ði?u ch?nh s? du",
      action: type === "add" ? "C?ng ti?n" : "Tr? ti?n",
      target: user.fullname,
      detail: `Admin ${req.user.fullname} dã ${type === "add" ? "c?ng" : "tr?"} ${amount.toLocaleString()}d. Lý do: ${reason}. S? du m?i: ${newMoney.toLocaleString()}d.`,
      tone: type === "add" ? "green" : "red",
    });

    res.json({
      success: true,
      message: `Ðã ${type === "add" ? "c?ng" : "tr?"} thành công ${amount.toLocaleString()}d cho ${user.fullname}.`,
      new_money: newMoney,
    });
  } catch (error) {
    next(error);
  }
}]);

route(["/api/admin/users/:id/status"], "put", [requireAdmin, async (req, res, next) => {
  try {
